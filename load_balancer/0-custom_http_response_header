#!/usr/bin/env bash
# Configures Nginx to add a custom X-Served-By response header set to the hostname

# shellcheck disable=SC2154

# Update package list and install nginx if it is not already installed
apt-get update -y
apt-get install -y nginx

# Make sure nginx is running before we go further
service nginx start

# Add the custom header inside the server block of the default site config.
# We insert it right after the "listen 80 default_server;" line so it only
# gets added once even if this script is re-run.
if ! grep -q "X-Served-By" /etc/nginx/sites-available/default; then
    sed -i "/listen 80 default_server;/a \\\tadd_header X-Served-By \$hostname;" /etc/nginx/sites-available/default
fi

# Restart nginx to apply the new configuration
service nginx restart