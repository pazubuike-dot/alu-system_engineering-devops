#!/usr/bin/env bash
# Configures a new Ubuntu machine with Nginx and a custom X-Served-By header
# Ignore SC2154 for shellcheck
# shellcheck disable=SC2154

# Update package lists and install Nginx
apt-get -y update
apt-get -y install nginx

# Get the server hostname and add the custom response header
HOSTNAME=$(hostname)
CONFIG_FILE="/etc/nginx/sites-available/default"

if ! grep -q "X-Served-By" "$CONFIG_FILE"; then
    sudo sed -i "s/server_name _;/server_name _;\n\tadd_header X-Served-By $HOSTNAME;/" "$CONFIG_FILE"
fi

# Test configuration and restart Nginx
nginx -t
sudo service nginx restart