#!/usr/bin/env bash
# Configure Nginx to add a custom X-Served-By header containing the server's hostname.
# Ignore SC2154 for shellcheck
# shellcheck disable=SC2154

# Update and install nginx
apt-get update -y
apt-get install -y nginx

# Get the server hostname
HOSTNAME=$(hostname)

# Path to default Nginx site configuration
CONFIG_FILE="/etc/nginx/sites-available/default"

# Add the header inside the server block if it doesn't already exist
if ! grep -q "X-Served-By" "$CONFIG_FILE"; then
    sed -i "s/server_name _;/server_name _;\n\tadd_header X-Served-By $HOSTNAME;/" "$CONFIG_FILE"
fi

# Test configuration and restart Nginx
nginx -t
service nginx restart