#!/usr/bin/env bash
# Configures a brand new Ubuntu machine with Nginx and a custom 404 error page

# Update and install Nginx
apt-get update -y
apt-get install -y nginx

# Create the custom 404 page with the exact required text string
echo "Ceci n'est pas une page" > /usr/share/nginx/html/custom_404.html

# Configure Nginx default server block to use the custom 404 page
sudo sed -i '/listen 80 default_server;/a \\n\terror_page 404 /custom_404.html;\n\tlocation = /custom_404.html {\n\t\tinternal;\n\t}' /etc/nginx/sites-available/default

# Restart Nginx service
sudo service nginx restart