#!/usr/bin/env bash
# Configures a brand new Ubuntu machine with Nginx and a custom 404 error page

# Update and install Nginx
apt-get update -y
apt-get install -y nginx

# Create the custom 404 HTML file with the exact required string
echo "Ceci n'est pas une page" > /var/www/html/custom_404.html

# Insert the error_page directive right before the closing brace of the default server block
sudo sed -i '/server {/a \    error_page 404 /custom_404.html;\n    location = /custom_404.html {\n        internal;\n    }' /etc/nginx/sites-available/default

# Restart Nginx service
sudo service nginx restart